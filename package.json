{
  "name": "portfolio",
  "version": "9.5.16",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "major": "npm version major",
    "minor": "npm version minor",
    "patch": "npm version patch",
    "preversion": "npm test",
    "version": "npm run lint && npm run build && git add docs",
    "postversion": "git push && git push --tags",
    "build": "ng build --base-href https://eskinderg.github.io/ --configuration production && npm run lang && cd docs && rm -rf * && cd .. && cp -ra dist/browser/. docs",
    "build-local": "ng build && npm run lang",
    "lang": "gulp minify",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --coverage --no-progress",
    "lint": "ng lint",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:css:fix": "stylelint \"src/**/*.{css,scss}\" --fix",
    "prepare": "husky",
    "serve:ssr:portfolio": "node dist/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.1.3",
    "@angular/compiler": "^22.1.3",
    "@angular/core": "^22.1.3",
    "@angular/platform-browser": "^22.1.3",
    "@angular/platform-browser-dynamic": "^22.1.3",
    "@angular/platform-server": "^22.1.3",
    "@angular/router": "^22.1.3",
    "@angular/ssr": "^22.1.5",
    "express": "^5.2.1",
    "gulp": "^5.0.0",
    "gulp-jsonminify": "^1.1.0",
    "gulp-rename": "^2.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "typescript-language-server": "^5.3.0"
  },
  "devDependencies": {
    "@angular/animations": "^22.1.3",
    "@angular/build": "^22.1.5",
    "@angular/cli": "^22.1.5",
    "@angular/compiler-cli": "^22.1.3",
    "@angular/language-server": "^21.2.0",
    "@angular/language-service": "^22.1.3",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~6.0.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "angular-eslint": "22.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^2.21.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.5.5",
    "ethiopian-calendar-new": "^1.1.0",
    "geezify-js": "^1.0.1",
    "husky": "^9.1.7",
    "jasmine-core": "~6.3.0",
    "jsdom": "^30.0.1",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "prettier": "~3.8.0",
    "prettier-eslint": "^17.1.0",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
